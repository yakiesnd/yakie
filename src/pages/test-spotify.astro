---
import Layout from '../layouts/Layout.astro';

const title = 'Test Spotify';
const description = 'Page de test Spotify';
---

<Layout
  title={title}
  description={description}
  lang="en"
  skipLabel="Skip to content"
  noAlternate
  light
>
  <main id="main" class="test-spotify">
    <h1>{title}</h1>
    <iframe
      data-testid="embed-iframe"
      style="border-radius:12px"
      src="https://open.spotify.com/embed/track/7yinbgIP5jtmlNxxWFipI6?utm_source=generator&si=bb2e880d993c4e43&autoplay=1"
      width="100%"
      height="352"
      allowfullscreen
      allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
      loading="eager"
      title="Lecteur Spotify"
    ></iframe>
  </main>
</Layout>

<style>
  .test-spotify {
    width: min(100% - 48px, 800px);
    margin-inline: auto;
    padding-block: 96px;
  }

  .test-spotify h1 {
    margin-bottom: 24px;
    font-size: var(--text-fluid-hero);
  }

  @media (max-width: 640px) {
    .test-spotify {
      width: min(100% - 32px, 800px);
      padding-block: 48px;
    }
  }
</style>
