---
import Layout from '../layouts/Layout.astro';

const title = 'Test Spotify';
const description = 'Page de test Spotify';
---

<Layout
  title={title}
  description={description}
  lang="fr"
  skipLabel="Passer au contenu"
  noAlternate
  light
>
  <main id="main" class="test-spotify">
    <h1>{title}</h1>
    <div id="spotify-embed" aria-label="Lecteur Spotify"></div>
    <p id="spotify-status" role="status" aria-live="polite">
      La lecture automatique peut être bloquée. Cliquez pour démarrer / Autoplay may be blocked. Click to start.
    </p>
    <button id="spotify-play" class="spotify-play" type="button" disabled>
      ▶ Démarrer la lecture / Start playback
    </button>
    <a
      class="spotify-link"
      href="https://open.spotify.com/track/7yinbgIP5jtmlNxxWFipI6"
      target="_blank"
      rel="noreferrer"
    >
      Ouvrir sur Spotify / Open in Spotify
    </a>
  </main>
</Layout>

<script is:inline>
  window.onSpotifyIframeApiReady = (IFrameAPI) => {
    const element = document.getElementById('spotify-embed');
    const button = document.getElementById('spotify-play');
    const status = document.getElementById('spotify-status');

    if (!element || !button || !status) return;

    IFrameAPI.createController(
      element,
      {
        uri: 'spotify:track:7yinbgIP5jtmlNxxWFipI6',
        width: '100%',
        height: 352,
      },
      (controller) => {
        let playbackStarted = false;
        button.disabled = false;

        controller.addListener('playback_started', () => {
          playbackStarted = true;
          button.hidden = true;
          status.textContent = 'Lecture en cours / Now playing.';
        });

        button.addEventListener('click', () => {
          controller.play();
          status.textContent = 'Démarrage de la lecture… / Starting playback…';
        });

        button.hidden = false;
        status.textContent =
          'Cliquez sur le bouton pour démarrer la lecture / Click the button to start playback.';
        controller.play();
        window.setTimeout(() => {
          if (!playbackStarted) {
            status.textContent =
              'Si la lecture ne démarre pas, cliquez sur le bouton vert / If playback does not start, click the green button.';
          }
        }, 1500);
      },
    );
  };
</script>
<script is:inline src="https://open.spotify.com/embed/iframe-api/v1" async></script>

<style>
  .test-spotify {
    width: min(100% - 48px, 800px);
    margin-inline: auto;
    padding-block: 96px;
  }

  .test-spotify h1 {
    margin-bottom: 24px;
    font-size: var(--text-fluid-hero);
  }

  #spotify-status,
  .spotify-link,
  .spotify-play {
    margin-top: 16px;
  }

  .spotify-play {
    display: block;
    padding: 14px 24px;
    border: 0;
    border-radius: 999px;
    background: #1ed760;
    color: #000;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .spotify-play:disabled {
    cursor: wait;
    opacity: 0.6;
  }

  .spotify-play[hidden] {
    display: none;
  }

  .spotify-link {
    display: inline-block;
    margin-left: 16px;
  }

  @media (max-width: 640px) {
    .test-spotify {
      width: min(100% - 32px, 800px);
      padding-block: 48px;
    }
  }
</style>
