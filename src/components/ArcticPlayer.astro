---
interface Props {
  lang: 'en' | 'fr';
}

const { lang } = Astro.props;
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/arctic-canvas/assets`;
const encodeAssetPath = (path: string) => encodeURI(path);
const tracks = [
  {
    title: 'Shiny Rust Eyes',
    subtitle: 'work in progress',
    src: encodeAssetPath(`${assetBase}/tracks/01 - Shinny Rust Eyes - WIP.ogg`),
    art: encodeAssetPath(`${assetBase}/tracks/02 - Your Light Roamed First.jpg`),
    artTitle: 'Your Light Roamed First',
    duration: 225,
  },
  {
    title: 'Your Light Roamed First',
    src: encodeAssetPath(`${assetBase}/tracks/02 - Your Light Roamed First.ogg`),
    art: encodeAssetPath(`${assetBase}/tracks/02 - Your Light Roamed First.jpg`),
    duration: 289,
  },
  {
    title: 'Ida Remains',
    src: encodeAssetPath(`${assetBase}/tracks/03 - Ida Remains.ogg`),
    art: encodeAssetPath(`${assetBase}/tracks/03 - Ida Remains.jpg`),
    duration: 244,
  },
  {
    title: 'Swallowing Canyon',
    src: encodeAssetPath(`${assetBase}/tracks/03 - Swallowing Canyon.ogg`),
    art: encodeAssetPath(`${assetBase}/tracks/03 - Swallowing Canyon.jpg`),
    duration: 307,
  },
  {
    title: 'Pale Comet',
    src: encodeAssetPath(`${assetBase}/tracks/05 - Pale Comet.ogg`),
    art: encodeAssetPath(`${assetBase}/tracks/05 - Pale Comet.jpg`),
    duration: 357,
  },
];
const formatDuration = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;
---

<section
  class="arctic-player"
  data-arctic-player
  aria-label={lang === 'fr' ? 'Lecteur musical' : 'Music player'}
>
  <img
    class="arctic-player-art"
    data-player-art
    src={tracks[0]!.art}
    alt={`${lang === 'fr' ? 'Pochette de' : 'Artwork for'} ${tracks[0]!.artTitle}`}
    width="600"
    height="600"
  />
  <div class="arctic-player-meta">
    <p class="arctic-player-title" data-player-title>
      {tracks[0]!.title} - <em>{tracks[0]!.subtitle}</em>
    </p>
    <div class="arctic-player-meta-row">
      <p class="arctic-player-artist">Yakie</p>
      <span class="arctic-player-time" data-player-time>0:00 / {formatDuration(tracks[0]!.duration)}</span>
    </div>
  </div>
  <div class="arctic-player-transport">
    <button
      class="arctic-player-play"
      type="button"
      data-player-toggle
      aria-label={lang === 'fr' ? 'Lire' : 'Play'}
    >
      <svg class="arctic-icon-play" viewBox="0 0 18 18" aria-hidden="true"><path d="M5 3l10 6-10 6z" fill="currentColor" /></svg>
      <svg class="arctic-icon-pause" viewBox="0 0 18 18" aria-hidden="true"><path d="M4 3h3.5v12H4zM10.5 3H14v12h-3.5z" fill="currentColor" /></svg>
    </button>
    <div class="arctic-player-wave">
      <canvas data-player-wave aria-hidden="true"></canvas>
      <input
        data-player-seek
        type="range"
        min="0"
        max="1000"
        value="0"
        step="1"
        aria-label={lang === 'fr' ? 'Position dans le morceau' : 'Position in track'}
      />
    </div>
  </div>
  <ol class="arctic-player-list" aria-label={lang === 'fr' ? 'Playlist' : 'Playlist'}>
    {tracks.map((track, index) => (
      <li>
        <button
          class="arctic-player-track"
          type="button"
          data-player-track
          data-track-index={index}
          data-track-title={track.title}
          data-track-subtitle={track.subtitle ?? ''}
          data-track-src={track.src}
          data-track-art={track.art}
          data-track-art-title={track.artTitle ?? track.title}
          data-track-duration={track.duration}
          aria-current={index === 0 ? 'true' : 'false'}
        >
          <span class="arctic-track-number">
            <span class="arctic-track-number-value">{index + 1}</span>
            <span class="arctic-track-eq" aria-hidden="true"><i></i><i></i><i></i></span>
          </span>
          <span class="arctic-track-title">
            {track.title}{track.subtitle && <> - <em>{track.subtitle}</em></>}
          </span>
          <span class="arctic-track-duration">{formatDuration(track.duration)}</span>
        </button>
      </li>
    ))}
  </ol>
</section>

<script>
  const widget = document.querySelector<HTMLElement>('[data-arctic-player]');

  if (widget) {
    const audio = new Audio();
    audio.preload = 'metadata';

    const playButton = widget.querySelector<HTMLButtonElement>('[data-player-toggle]');
    const art = widget.querySelector<HTMLImageElement>('[data-player-art]');
    const title = widget.querySelector<HTMLElement>('[data-player-title]');
    const time = widget.querySelector<HTMLElement>('[data-player-time]');
    const canvas = widget.querySelector<HTMLCanvasElement>('[data-player-wave]');
    const seek = widget.querySelector<HTMLInputElement>('[data-player-seek]');
    const trackButtons = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-player-track]'));

    if (playButton && art && title && time && canvas && seek) {
      let currentIndex = 0;
      let isPlaying = false;
      const context = canvas.getContext('2d');

      const getTrackDuration = () => (
        Number.isFinite(audio.duration) && audio.duration > 0
          ? audio.duration
          : Number(trackButtons[currentIndex]?.dataset.trackDuration ?? 0)
      );
      const formatTime = (seconds: number) => {
        const value = Math.max(0, Math.floor(seconds));
        return `${Math.floor(value / 60)}:${String(value % 60).padStart(2, '0')}`;
      };

      const drawWave = () => {
        const bounds = canvas.getBoundingClientRect();
        const pixelRatio = window.devicePixelRatio || 1;
        if (!bounds.width || !context) return;
        canvas.width = Math.round(bounds.width * pixelRatio);
        canvas.height = Math.round(bounds.height * pixelRatio);
        context.scale(pixelRatio, pixelRatio);

        const count = Math.floor(bounds.width / 3);
        const progress = getTrackDuration() ? audio.currentTime / getTrackDuration() : 0;
        for (let index = 0; index < count; index += 1) {
          const envelope = Math.sin((index / count) * Math.PI) ** 0.6;
          const peak = 0.16 + ((Math.sin(index * 12.9898 + currentIndex * 78.233) * 43758.5453) % 1 + 1) % 1 * envelope * 0.8;
          const height = Math.max(2, peak * bounds.height);
          context.fillStyle = index / count < progress ? '#1715d9' : '#b7b2af';
          context.fillRect(index * 3, (bounds.height - height) / 2, 1.5, height);
        }
      };

      const render = () => {
        const duration = getTrackDuration();
        time.textContent = `${formatTime(audio.currentTime)} / ${formatTime(duration)}`;
        if (document.activeElement !== seek) {
          seek.value = duration ? String(Math.round((audio.currentTime / duration) * 1000)) : '0';
        }
        drawWave();
      };

      const setPlaying = (playing: boolean) => {
        isPlaying = playing;
        widget.classList.toggle('is-playing', playing);
        playButton.setAttribute(
          'aria-label',
          playing
            ? (widget.lang === 'fr' ? 'Mettre en pause' : 'Pause')
            : (widget.lang === 'fr' ? 'Lire' : 'Play'),
        );
      };

      const pause = () => {
        audio.pause();
        setPlaying(false);
      };

      const play = () => {
        void audio.play().then(() => setPlaying(true)).catch((error: unknown) => {
          console.error('Unable to play this track.', error);
          setPlaying(false);
        });
      };

      const loadTrack = (index: number, autoplay: boolean) => {
        const track = trackButtons[index];
        if (!track) return;
        pause();
        currentIndex = index;
        audio.src = track.dataset.trackSrc ?? '';
        audio.currentTime = 0;
        art.src = track.dataset.trackArt ?? '';
        art.alt = `${widget.lang === 'fr' ? 'Pochette de' : 'Artwork for'} ${track.dataset.trackArtTitle ?? ''}`;
        title.replaceChildren(document.createTextNode(track.dataset.trackTitle ?? ''));
        if (track.dataset.trackSubtitle) {
          const subtitle = document.createElement('em');
          subtitle.textContent = track.dataset.trackSubtitle;
          title.append(document.createTextNode(' - '));
          title.append(subtitle);
        }
        trackButtons.forEach((button, trackIndex) => {
          button.setAttribute('aria-current', trackIndex === index ? 'true' : 'false');
        });
        render();
        if (autoplay) play();
      };

      playButton.addEventListener('click', () => {
        if (isPlaying) pause();
        else play();
      });

      trackButtons.forEach((button, index) => {
        button.addEventListener('click', () => {
          if (index === currentIndex) {
            if (isPlaying) pause();
            else play();
          } else {
            loadTrack(index, true);
          }
        });
      });

      seek.addEventListener('input', () => {
        const duration = getTrackDuration();
        if (duration) audio.currentTime = (Number(seek.value) / 1000) * duration;
        render();
      });

      audio.addEventListener('play', () => setPlaying(true));
      audio.addEventListener('pause', () => setPlaying(false));
      audio.addEventListener('timeupdate', render);
      audio.addEventListener('loadedmetadata', render);
      audio.addEventListener('ended', () => {
        const nextIndex = (currentIndex + 1) % trackButtons.length;
        loadTrack(nextIndex, nextIndex !== 0);
      });
      audio.addEventListener('error', () => {
        if (audio.error) console.error('Unable to load this track.', audio.error.message);
      });
      new ResizeObserver(drawWave).observe(canvas);

      render();
    }
  }
</script>

<style>
  .arctic-player {
    --player-art-size: clamp(5rem, 11vw, 10.5rem);
    --player-ink: #171515;
    --player-muted: #595454;
    --player-line: #d2cecc;
    display: grid;
    grid-template-columns: var(--player-art-size) minmax(0, 1.1fr) minmax(13rem, 0.9fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "art meta list"
      "art transport list";
    column-gap: clamp(0.75rem, 2vw, 1.75rem);
    width: 100%;
  }

  .arctic-player-art {
    grid-area: art;
    display: block;
    width: var(--player-art-size);
    aspect-ratio: 1;
    object-fit: cover;
    background: #f1efed;
  }

  .arctic-player-meta { grid-area: meta; min-width: 0; }
  .arctic-player-title {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.85rem);
    line-height: 1.15;
  }
  .arctic-player-title em,
  .arctic-track-title em { font-size: 0.82em; }
  .arctic-player-meta-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }
  .arctic-player-artist,
  .arctic-player-time { margin: 0; color: var(--player-muted); }
  .arctic-player-time { flex: none; font-size: 0.78rem; font-variant-numeric: tabular-nums; }
  .arctic-player-transport {
    grid-area: transport;
    align-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.35rem;
  }
  .arctic-player-play {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    place-items: center;
    border: 0;
    border-radius: 50%;
    color: #fff;
    background: #1715d9;
    cursor: pointer;
  }
  .arctic-player-play svg { width: 1.125rem; height: 1.125rem; }
  .arctic-icon-pause { display: none; }
  .is-playing .arctic-icon-play { display: none; }
  .is-playing .arctic-icon-pause { display: block; }
  .arctic-player-wave {
    position: relative;
    width: 100%;
    min-width: 0;
    height: 3.5rem;
  }
  .arctic-player-wave canvas { display: block; width: 100%; height: 100%; }
  .arctic-player-wave input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .arctic-player-list {
    grid-area: list;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--player-line);
    list-style: none;
  }
  .arctic-player-list li { border-bottom: 1px solid var(--player-line); }
  .arctic-player-track {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.35rem 0.1rem;
    border: 0;
    color: var(--player-muted);
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .arctic-player-track:hover,
  .arctic-player-track[aria-current='true'] { color: var(--player-ink); }
  .arctic-track-number,
  .arctic-track-duration {
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .arctic-track-title {
    overflow: hidden;
    font-size: 0.9rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .arctic-track-eq { display: none; gap: 2px; align-items: end; height: 11px; }
  .arctic-track-eq i { width: 2px; height: 100%; background: currentColor; transform-origin: bottom; }
  .is-playing .arctic-player-track[aria-current='true'] .arctic-track-eq { display: flex; }
  .is-playing .arctic-player-track[aria-current='true'] .arctic-track-number-value { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .is-playing .arctic-track-eq i { animation: arctic-eq 1.1s ease-in-out infinite; }
    .is-playing .arctic-track-eq i:nth-child(2) { animation-delay: -0.4s; }
    .is-playing .arctic-track-eq i:nth-child(3) { animation-delay: -0.8s; }
  }
  @keyframes arctic-eq {
    0%, 100% { transform: scaleY(0.3); }
    50% { transform: scaleY(1); }
  }

  @media (max-width: 900px) {
    .arctic-player {
      grid-template-columns: var(--player-art-size) minmax(0, 1fr);
      grid-template-areas:
        "art meta"
        "transport transport"
        "list list";
      column-gap: 1rem;
    }
    .arctic-player-meta { align-self: end; }
    .arctic-player-transport { padding: 1rem 0; }
  }
</style>
