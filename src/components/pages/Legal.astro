---
/** Mentions légales / Confidentialité — spec §8 RGPD : éditeur, hébergeur (Automattic/WordPress.com → à mettre à jour après bascule GitHub Pages) */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { site } from '../../data/site';

interface Props {
  lang: Lang;
  variant: 'legal' | 'privacy';
}

const { lang, variant } = Astro.props;
const { t, tGroup } = useTranslations(lang);
const altPath = variant === 'legal' ? '/legal/' : '/privacy/';
const title = variant === 'legal' ? t('footer.legal') : t('footer.privacy');

const content = {
  en: {
    legal: [
      ['Publisher', `${site.name} — Sole proprietor`],
      ['Host', 'GitHub, Inc., 88 Colin P Kelly Jr St, San Francisco, CA 94107, USA (GitHub Pages)'],
      ['Intellectual property', 'All content on this site (text, images, audio, video) is the property of Mathieu Fiorentini or of the respective rights holders (publishers, press kits).'],
    ],
    privacy: [
      ['No cookies, no tracking', 'This site sets no cookies and uses no tracking. The Music page loads the WaveformPlayer library and stylesheet from the unpkg CDN; those requests may disclose technical data such as your IP address. Audio files will be requested from their configured host when played.'],
      ['Contact', 'If you contact the site owner, your message is handled only to reply to your inquiry.'],
      ['Data retention', 'Messages are kept only as long as necessary to handle your request.'],
      ['Your rights', 'You may request access, rectification or deletion of your data by contacting the site owner.'],
    ],
  },
  fr: {
    legal: [
      ['Éditeur', `${site.name} — Entrepreneur individuel`],
      ['Hébergeur', 'GitHub, Inc., 88 Colin P Kelly Jr St, San Francisco, CA 94107, USA (GitHub Pages)'],
      ['Propriété intellectuelle', 'L’ensemble des contenus de ce site (textes, images, audio, vidéo) est la propriété de Mathieu Fiorentini ou de leurs ayants droit respectifs (éditeurs, kits presse).'],
    ],
    privacy: [
      ['Zéro cookie, zéro tracking', 'Ce site ne dépose aucun cookie et n’utilise aucun traceur. La page Musique charge la bibliothèque et la feuille de style du lecteur WaveformPlayer depuis le CDN unpkg ; ces requêtes peuvent transmettre des données techniques, comme votre adresse IP. Les fichiers audio seront demandés à leur hébergeur lorsqu’ils seront lus.'],
      ['Contact', 'Si vous contactez le propriétaire, votre message est utilisé uniquement pour répondre à votre demande.'],
      ['Conservation des données', 'Les messages de contact ne sont conservés que le temps nécessaire au traitement de votre demande.'],
      ['Vos droits', 'Vous pouvez demander l’accès, la rectification ou la suppression de vos données en contactant le propriétaire.'],
    ],
  },
}[lang][variant];
---

<Layout title={`${title} — ${site.name}`} description={title} lang={lang} altPath={altPath} skipLabel={t('skipToContent')}>
  <Header lang={lang} altPath={altPath} />
  <main id="main">
    <section class="container-site section !pt-16">
      <h1 class="text-2xl font-bold">{title}</h1>
      <div class="measure mt-8 space-y-8">
        {content.map(([heading, text]) => (
          <div>
            <h2 class="font-semibold">{heading}</h2>
            <p class="text-meta mt-2">{text}</p>
          </div>
        ))}
        {
          /* Backlink conception — retour Mathieu : créditer discret en mentions légales */
          variant === 'legal' && (
            <div>
              <h2 class="font-semibold">{lang === 'fr' ? 'Conception du site' : 'Site design & development'}</h2>
              <p class="text-meta mt-2">
                {lang === 'fr' ? 'Conception et développement : ' : 'Design and development: '}
                <a href="https://camilleaubert.com" rel="noopener" target="_blank" class="text-accent">
                  Camille Aubert — camilleaubert.com
                </a>
              </p>
            </div>
          )
        }
      </div>
    </section>
  </main>
  <Footer lang={lang} altPath={altPath} />
</Layout>
