---
import Layout from '../../layouts/Layout.astro';
import { portfolioCopy, portfolioSections, type PortfolioSection } from '../../data/portfolio';
import { site } from '../../data/site';
import { pageUrl, useTranslations, type Lang } from '../../i18n/ui';

type PageSection = PortfolioSection | 'home';

interface Props {
  lang: Lang;
  section: PageSection;
}

const { lang, section } = Astro.props;
const { t } = useTranslations(lang);
const page = section === 'home'
  ? { title: { en: 'Home', fr: 'Accueil' } }
  : portfolioCopy[section];
const currentPage = portfolioSections.find((item) => item.id === section);
if (section !== 'home' && !currentPage) throw new Error(`Section de portfolio manquante : ${section}`);
const altPath = section === 'home' ? '/' : currentPage!.path;
const otherLang: Lang = lang === 'en' ? 'fr' : 'en';
const socialLinks = [
  ...site.socials,
  { label: 'YouTube', url: `https://www.youtube.com/watch?v=${site.showreelYouTubeId}` },
];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: site.name,
  url: Astro.site?.href,
  sameAs: socialLinks.map((social) => social.url),
};
const previewTracks = Array.from({ length: 5 }, (_, index) => ({
  index,
  title: lang === 'fr' ? `Morceau ${String(index + 1).padStart(2, '0')}` : `Track ${String(index + 1).padStart(2, '0')}`,
  url: '',
  artwork: '',
}));
const previewCover = (index: number) => {
  const palettes = [
    ['#d94734', '#edc440'],
    ['#3f53e8', '#d94734'],
    ['#edc440', '#3f53e8'],
    ['#d94734', '#3f53e8'],
    ['#3f53e8', '#edc440'],
  ];
  const [primary, secondary] = palettes[index]!;
  const number = String(index + 1).padStart(2, '0');
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400"><rect width="400" height="400" fill="${primary}"/><circle cx="300" cy="90" r="180" fill="${secondary}" opacity=".82"/><path d="M0 290 400 150v250H0z" fill="#171515" opacity=".8"/><text x="32" y="350" fill="#fff" font-family="sans-serif" font-size="54" letter-spacing="8">YAKIE</text><text x="340" y="350" fill="#fff" font-family="sans-serif" font-size="24" text-anchor="end">${number}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};
---

<Layout
  title={`${page.title[lang]} — Yakie`}
  description={`Yakie — ${page.title[lang]}`}
  lang={lang}
  altPath={altPath}
  skipLabel={t('skipToContent')}
  schema={personSchema}
  light
>
  {section === 'music' && (
    <Fragment slot="head">
      <link
        rel="stylesheet"
        href="https://unpkg.com/@arraypress/waveform-player@1.29.1/dist/waveform-player.css"
      />
    </Fragment>
  )}
  <div class="portfolio-page">
    <header class="portfolio-header">
      <a class="portfolio-brand" href={pageUrl(lang, '/')}>
        <strong>YAKIE</strong>
      </a>
      <div class="portfolio-header-links">
        <nav class="portfolio-socials" aria-label={lang === 'fr' ? 'Réseaux sociaux' : 'Social links'}>
          {socialLinks.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label.replace(' (Yakie)', '')}</a>
          ))}
        </nav>
        <a class="portfolio-language" href={pageUrl(otherLang, altPath)} hreflang={otherLang}>
          {otherLang.toUpperCase()}
        </a>
      </div>
    </header>

    <main id="main" class:list={['portfolio-main', { 'portfolio-main-music': section === 'music' }]}>
      <h1 class="sr-only">Yakie — {page.title[lang]}</h1>
      <nav class="portfolio-menu" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        <ol>
          {portfolioSections.map((item) => (
            <li>
              <a
                href={pageUrl(lang, item.path)}
                aria-current={section === item.id ? 'page' : undefined}
                class:list={{ 'portfolio-menu-current': section === item.id }}
              >
                <span>{item.label[lang]}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {section === 'music' ? (
        <section class="portfolio-player" aria-label={lang === 'fr' ? 'Lecteur et playlist de Yakie' : 'Yakie player and playlist'}>
          <div
            class="portfolio-player-widget"
            data-music-playlist
            data-play-label={lang === 'fr' ? 'Lire le morceau' : 'Play track'}
            data-pause-label={lang === 'fr' ? 'Mettre en pause' : 'Pause'}
            data-artwork-suffix={lang === 'fr' ? 'pochette' : 'artwork'}
            role="group"
            aria-label={lang === 'fr' ? 'Lecteur et playlist de Yakie' : 'Yakie player and playlist'}
          >
            <div class="portfolio-player-current">
              <img
                class="portfolio-player-artwork"
                data-current-artwork
                src={previewCover(0)}
                width="400"
                height="400"
                alt={lang === 'fr' ? 'Pochette provisoire du morceau 01' : 'Placeholder artwork for track 01'}
              />
              <div class="portfolio-player-main">
                <div class="portfolio-player-now-playing">
                  <button class="portfolio-player-toggle" type="button" data-player-toggle disabled>
                    <svg data-player-play-icon viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
                    <svg data-player-pause-icon viewBox="0 0 24 24" aria-hidden="true" style="display:none"><path d="M6 5h4v14H6zM14 5h4v14h-4z" /></svg>
                  </button>
                  <div class="portfolio-player-track-title" aria-live="polite">
                    <span data-current-track-title>{previewTracks[0]!.title}</span>
                    <span class="portfolio-player-artist">{site.name}</span>
                  </div>
                </div>
                <div
                  class="portfolio-waveform"
                  data-player-waveform
                  data-title={previewTracks[0]!.title}
                  data-artist={site.name}
                  aria-label={lang === 'fr' ? 'Forme d’onde audio' : 'Audio waveform'}
                ></div>
              </div>
            </div>
            <ol class="portfolio-player-tracklist" aria-label={lang === 'fr' ? 'Playlist' : 'Playlist'}>
              {previewTracks.map((track) => (
                <li>
                  <button
                    type="button"
                    class="portfolio-player-track"
                    data-track-index={track.index}
                    data-track-title={track.title}
                    data-track-url={track.url}
                    data-track-artwork={track.artwork}
                    data-track-placeholder-artwork={previewCover(track.index)}
                    aria-current={track.index === 0 ? 'true' : undefined}
                  >
                    <span>{track.title}</span>
                    <span class="portfolio-player-track-duration">—:—</span>
                  </button>
                </li>
              ))}
            </ol>
          </div>
        </section>
      ) : (
        <nav class="portfolio-leaves" aria-label={lang === 'fr' ? 'Explorer les pages' : 'Explore the pages'}>
          {portfolioSections.map((item) => (
            <a
              class:list={['portfolio-leaf', item.position, `leaf-${item.color}`, `leaf-${item.size}`]}
              href={pageUrl(lang, item.path)}
              aria-label={item.label[lang]}
              aria-current={section === item.id ? 'page' : undefined}
              style={`--leaf-rotation: ${item.rotation}deg`}
            >
              <span>{item.label[lang]}</span>
              <svg viewBox="0 0 100 160" aria-hidden="true">
                <path class="leaf-shape" d="M50 4C22 28 5 58 8 91c3 30 21 52 42 65 21-13 39-35 42-65C95 58 78 28 50 4Z" />
                <path class="leaf-vein" d="M50 145C49 104 49 59 50 15" />
                <path class="leaf-vein" d="M49 88 27 58M50 108l23-35" />
              </svg>
            </a>
          ))}
        </nav>
      )}
    </main>

    {section === 'music' && (
      <script>
        interface WaveformPlayerInstance {
          loadTrack(
            url: string,
            title?: string | null,
            artist?: string | null,
            options?: { autoplay?: boolean },
          ): Promise<void>;
          pause(): void;
          setWaveformData(data: number[]): void;
          togglePlay(): void;
        }

        interface WaveformPlayerOptions {
          showControls: false;
          showInfo: false;
          showTime: false;
          waveformStyle: 'mirror';
          preload: 'none';
          singlePlay: true;
          waveformColor: string;
          progressColor: string;
          onPlay: () => void;
          onPause: () => void;
        }

        declare global {
          interface Window {
            WaveformPlayer?: new (
              container: HTMLElement,
              options: WaveformPlayerOptions,
            ) => WaveformPlayerInstance;
          }
        }

        const widget = document.querySelector<HTMLElement>('[data-music-playlist]');
        const waveform = widget?.querySelector<HTMLElement>('[data-player-waveform]');

        if (widget && waveform) {
          const previewPeaks = [
            0.26, 0.58, 0.82, 0.42, 0.94, 0.64, 1, 0.5, 0.78, 1, 0.7, 0.46, 0.88, 0.62, 1,
            0.66, 0.42, 0.84, 0.96, 0.6, 0.4, 0.88, 0.68, 1, 0.54, 0.76, 0.9, 0.48, 0.7, 0.58,
          ];
          const loadPlayerRuntime = () => new Promise<void>((resolve, reject) => {
            if (window.WaveformPlayer) {
              resolve();
              return;
            }

            const script = document.createElement('script');
            script.src = 'https://unpkg.com/@arraypress/waveform-player@1.29.1/dist/waveform-player.min.js';
            script.async = true;
            script.onload = () => resolve();
            script.onerror = () => reject(new Error('Impossible de charger WaveformPlayer depuis unpkg.'));
            document.head.append(script);
          });

          void loadPlayerRuntime().then(() => {
            const WaveformPlayer = window.WaveformPlayer;
            if (!WaveformPlayer) throw new Error('WaveformPlayer est indisponible après le chargement.');

            const cover = widget.querySelector<HTMLImageElement>('[data-current-artwork]');
            const title = widget.querySelector<HTMLElement>('[data-current-track-title]');
            const toggle = widget.querySelector<HTMLButtonElement>('[data-player-toggle]');
            const playIcon = widget.querySelector<SVGElement>('[data-player-play-icon]');
            const pauseIcon = widget.querySelector<SVGElement>('[data-player-pause-icon]');
            const tracks = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-track-index]'));
            if (!cover || !title || !toggle || !playIcon || !pauseIcon) return;

            const setPlaying = (playing: boolean) => {
              playIcon.style.display = playing ? 'none' : '';
              pauseIcon.style.display = playing ? '' : 'none';
              toggle.setAttribute('aria-label', playing ? widget.dataset.pauseLabel ?? '' : widget.dataset.playLabel ?? '');
            };

            const player = new WaveformPlayer(waveform, {
              showControls: false,
              showInfo: false,
              showTime: false,
              waveformStyle: 'mirror',
              preload: 'none',
              singlePlay: true,
              waveformColor: 'rgba(63, 83, 232, 0.38)',
              progressColor: '#1715d9',
              onPlay: () => setPlaying(true),
              onPause: () => setPlaying(false),
            });
            waveform.classList.add('portfolio-waveform');
            player.setWaveformData(previewPeaks);

            let currentIndex = 0;
            let currentUrl = '';

            toggle.addEventListener('click', () => {
              if (currentUrl) player.togglePlay();
            });

            tracks.forEach((track) => {
              track.addEventListener('click', () => {
                const index = Number(track.dataset.trackIndex);
                const url = track.dataset.trackUrl ?? '';
                const trackTitle = track.dataset.trackTitle ?? '';
                const artwork = track.dataset.trackArtwork || track.dataset.trackPlaceholderArtwork || '';
                tracks.forEach((item) => item.removeAttribute('aria-current'));
                track.setAttribute('aria-current', 'true');
                cover.src = artwork;
                cover.alt = `${trackTitle} — ${widget.dataset.artworkSuffix ?? 'artwork'}`;
                title.textContent = trackTitle;

                if (index === currentIndex && url && currentUrl) {
                  player.togglePlay();
                  return;
                }

                currentIndex = index;
                if (!url) {
                  currentUrl = '';
                  player.pause();
                  toggle.disabled = true;
                  setPlaying(false);
                  player.setWaveformData(previewPeaks);
                  return;
                }

                currentUrl = url;
                toggle.disabled = false;
                void player.loadTrack(url, trackTitle, 'Yakie', { autoplay: true }).catch((error: unknown) => {
                  console.error('Impossible de lire ce morceau avec WaveformPlayer.', error);
                  setPlaying(false);
                });
              });
            });
          }).catch((error: unknown) => {
            console.error('Impossible d’initialiser le lecteur musical.', error);
          });
        }
      </script>
    )}

    <footer class="portfolio-footer">
      <span>{page.title[lang]}</span>
    </footer>
  </div>
</Layout>

<style>
  .portfolio-page {
    --ink: #171515;
    --leaf-red: #d94734;
    --leaf-yellow: #edc440;
    --leaf-blue: #3f53e8;
    box-sizing: border-box;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    padding: clamp(1.25rem, 2.65vw, 3.3rem);
    color: var(--ink);
    background: #fff;
    font-size: clamp(1rem, 1.1vw, 1.3rem);
  }

  .portfolio-header,
  .portfolio-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .portfolio-brand {
    display: flex;
    width: min(20rem, 42vw);
    flex-direction: column;
    border-top: 1px solid currentColor;
    padding-top: 0.4rem;
    color: inherit !important;
    text-decoration: none !important;
    letter-spacing: 0.1em;
  }

  .portfolio-brand strong {
    margin-top: 0.05em;
    font-size: clamp(3.4rem, 6vw, 6.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .portfolio-header-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  .portfolio-socials {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .portfolio-socials a,
  .portfolio-language,
  .portfolio-footer a {
    color: inherit !important;
    text-decoration: none !important;
  }

  .portfolio-socials a:hover,
  .portfolio-language:hover,
  .portfolio-footer a:hover {
    text-decoration: underline !important;
    text-underline-offset: 0.2em;
  }

  .portfolio-language {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }

  .portfolio-main {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 2.5fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 10rem);
    padding-block: clamp(2rem, 5vh, 4rem);
  }

  .portfolio-main-music {
    grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 2.5fr);
  }

  .portfolio-menu ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portfolio-menu li {
    border-bottom: 1px solid var(--ink);
  }

  .portfolio-menu a {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 1rem;
    padding-block: 0.48rem;
    color: inherit !important;
    text-decoration: none !important;
  }

  .portfolio-menu a:hover span,
  .portfolio-menu-current span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .portfolio-leaves {
    position: relative;
    width: 100%;
    max-width: 60rem;
    aspect-ratio: 1.55;
    justify-self: end;
  }

  .portfolio-leaf {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: inherit !important;
    text-decoration: none !important;
    white-space: nowrap;
  }

  .portfolio-leaf span {
    transition: transform 160ms ease;
  }

  .portfolio-leaf svg {
    display: block;
    width: var(--leaf-width);
    height: calc(var(--leaf-width) * 1.6);
    overflow: visible;
    color: var(--leaf-color);
    transform: rotate(var(--leaf-rotation));
    filter: drop-shadow(0.35rem 0.4rem 0.55rem color-mix(in srgb, currentColor, transparent 58%));
    transition: transform 200ms ease;
  }

  .leaf-shape {
    fill: currentColor;
  }

  .leaf-vein {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-width: 2;
    opacity: 0.65;
  }

  .portfolio-leaf:hover svg,
  .portfolio-leaf:focus-visible svg {
    transform: rotate(var(--leaf-rotation)) scale(1.12);
  }

  .leaf-red { --leaf-color: var(--leaf-red); }
  .leaf-yellow { --leaf-color: var(--leaf-yellow); }
  .leaf-blue { --leaf-color: var(--leaf-blue); }
  .leaf-large { --leaf-width: clamp(3.5rem, 4.4vw, 5.8rem); }
  .leaf-medium { --leaf-width: clamp(2.7rem, 3.3vw, 4.2rem); }
  .leaf-small { --leaf-width: clamp(1.8rem, 2.2vw, 2.8rem); }
  .leaf-tiny { --leaf-width: clamp(1.2rem, 1.4vw, 1.8rem); }

  .leaf-music { left: 83%; top: 4%; }
  .leaf-visuals { left: 42%; top: 17%; }
  .leaf-residencies { left: 66%; top: 60%; }
  .leaf-commissioned { left: 81%; top: 52%; }
  .leaf-about { left: 13%; top: 66%; }

  .portfolio-footer {
    align-items: center;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3rem;
  }

  .portfolio-player {
    width: min(100%, 34rem);
    margin-inline: auto;
  }

  .portfolio-player-widget {
    --portfolio-cover-size: 6rem;
    --wfp-accent: #d94734;
    --wfp-button-color: #171515;
    --wfp-text-color: #171515;
    --wfp-text-secondary-color: #595454;
  }

  .portfolio-player-current {
    display: grid;
    grid-template-columns: var(--portfolio-cover-size) minmax(0, 1fr);
    gap: 0.75rem;
    align-items: stretch;
  }

  .portfolio-player-artwork {
    display: block;
    width: var(--portfolio-cover-size);
    aspect-ratio: 1;
    object-fit: cover;
    background: #e7e4e2;
  }

  .portfolio-player-main {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: space-between;
    padding-block: 0.15rem;
  }

  .portfolio-player-now-playing {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.6rem;
  }

  .portfolio-player-toggle {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    flex: none;
    place-items: center;
    border: 0;
    border-radius: 9999px;
    color: white;
    background: #1715d9;
    cursor: pointer;
  }

  .portfolio-player-toggle:disabled {
    cursor: default;
    opacity: 0.48;
  }

  .portfolio-player-toggle svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .portfolio-player-track-title {
    min-width: 0;
    overflow: hidden;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .portfolio-player-artist {
    display: block;
    overflow: hidden;
    color: #595454;
    font-size: 0.78em;
    font-weight: 400;
    text-overflow: ellipsis;
  }

  .portfolio-waveform {
    min-width: 0;
    width: 100%;
  }

  .portfolio-waveform .waveform-info {
    display: none;
  }

  .portfolio-waveform .waveform-container {
    min-height: 3rem;
  }

  .portfolio-waveform canvas {
    height: 3rem;
  }

  .portfolio-waveform .waveform-player {
    --waveform-body-gap: 0;
  }

  .portfolio-player-tracklist {
    margin: 0.65rem 0 0;
    padding: 0;
    border-top: 1px solid #d2cecc;
    list-style: none;
  }

  .portfolio-player-track {
    display: flex;
    width: 100%;
    min-height: 2.4rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    border: 0;
    border-bottom: 1px solid #d2cecc;
    border-left: 2px solid transparent;
    padding: 0.3rem 0.55rem;
    color: #595454;
    background: transparent;
    cursor: pointer;
    font-size: 0.9rem;
    text-align: left;
  }

  .portfolio-player-track[aria-current='true'] {
    border-left-color: #1715d9;
    color: #171515;
  }

  .portfolio-player-track-duration {
    flex: none;
    color: #595454;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 420px) {
    .portfolio-player-widget {
      --portfolio-cover-size: 5rem;
    }

    .portfolio-player-track {
      min-height: 2.25rem;
    }
  }

  @media (max-width: 760px) {
    .portfolio-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 3rem;
    }

    .portfolio-menu ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.2rem;
    }

    .portfolio-leaves {
      min-height: 20rem;
      aspect-ratio: 1.3;
    }

    .portfolio-player {
      margin-top: 1rem;
    }

    .leaf-music { left: 79%; top: 4%; }
    .leaf-visuals { left: 42%; top: 13%; }
    .leaf-residencies { left: 65%; top: 58%; }
    .leaf-commissioned { left: 79%; top: 54%; }
    .leaf-about { left: 11%; top: 68%; }
  }

  @media (max-width: 420px) {
    .portfolio-page { padding: 1.1rem; }
    .portfolio-main { gap: 1.5rem; }
    .portfolio-menu ol { column-gap: 0.8rem; }
    .portfolio-leaves { min-height: 17rem; }
  }
</style>
