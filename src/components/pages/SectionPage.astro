---
import Layout from '../../layouts/Layout.astro';
import ArcticPlayer from '../ArcticPlayer.astro';
import ArcticVisualReel from '../ArcticVisualReel.astro';
import { portfolioCopy, portfolioResidencies, portfolioSections, type PortfolioSection } from '../../data/portfolio';
import { site } from '../../data/site';
import { pageUrl, useTranslations, type Lang } from '../../i18n/ui';

type PageSection = PortfolioSection | 'home';

interface Props {
  lang: Lang;
  section: PageSection;
}

const { lang, section } = Astro.props;
const { t } = useTranslations(lang);
const page = section === 'home'
  ? { title: { en: 'Home', fr: 'Accueil' } }
  : portfolioCopy[section];
const currentPage = portfolioSections.find((item) => item.id === section);
if (section !== 'home' && !currentPage) throw new Error(`Section de portfolio manquante : ${section}`);
const altPath = section === 'home' ? '/' : currentPage!.path;
const otherLang: Lang = lang === 'en' ? 'fr' : 'en';
const socialLinks = [
  ...site.socials,
  { label: 'YouTube', url: `https://www.youtube.com/watch?v=${site.showreelYouTubeId}` },
];
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: site.name,
  url: Astro.site?.href,
  sameAs: socialLinks.map((social) => social.url),
};
const pageMessage = section === 'residencies' || section === 'commissionedWork'
  ? (lang === 'fr' ? 'Page en construction' : 'Page under construction')
  : '';
const aboutText = lang === 'fr'
  ? 'Je suis Yakie, musicien d’electronica et artiste visuel français basé à Paris. J’ai sorti un disque en vinyle et en numérique, et réalisé des créations sur commande pour la radio nationale française France Inter. Ma musique est à la fois rugueuse et aérienne, faite pour danser : mélancolique, jamais immobile, construite autour de l’harmonie et des percussions. Je l’écris à partir d’un lieu. Les visuels réagissent au son et naissent de la lumière et des objets que j’y trouve.'
  : 'I\'m Yakie, a French electronica musician and visual artist based in Paris. I\'ve put out my own release on vinyl and digital, and made commissioned work for the French national radio station France Inter. My music is both gritty and aerial, made to move to: melancholic, never still, built on harmony and drums. I write it from a place. The visuals are audio-reactive and come from the light and the objects I find there.';
---

<Layout
  title={`${page.title[lang]} — Yakie`}
  description={`Yakie — ${page.title[lang]}`}
  lang={lang}
  altPath={altPath}
  skipLabel={t('skipToContent')}
  schema={personSchema}
  light
>
  <div class="portfolio-page">
    <header class="portfolio-header">
      <a class="portfolio-brand" href={pageUrl(lang, '/')}>
        <strong>YAKIE</strong>
      </a>
      <div class="portfolio-header-links">
        <nav class="portfolio-socials" aria-label={lang === 'fr' ? 'Réseaux sociaux' : 'Social links'}>
          {socialLinks.map((social) => (
            <a href={social.url} target="_blank" rel="noopener noreferrer">{social.label.replace(' (Yakie)', '')}</a>
          ))}
        </nav>
        <a class="portfolio-language" href={pageUrl(otherLang, altPath)} hreflang={otherLang}>
          {otherLang.toUpperCase()}
        </a>
      </div>
    </header>

    <main id="main" class:list={['portfolio-main', { 'portfolio-main-music': section === 'music', 'portfolio-main-residencies': section === 'residencies' }]}>
      <h1 class="sr-only">Yakie — {page.title[lang]}</h1>
      <nav class="portfolio-menu" aria-label={lang === 'fr' ? 'Navigation principale' : 'Main navigation'}>
        <ol>
          {portfolioSections.map((item) => (
            <li>
              <a
                href={pageUrl(lang, item.path)}
                aria-current={section === item.id ? 'page' : undefined}
                class:list={{ 'portfolio-menu-current': section === item.id }}
              >
                <span>{item.label[lang]}</span>
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {section === 'music' ? (
        <ArcticPlayer lang={lang} />
      ) : section === 'visuals' ? (
        <ArcticVisualReel lang={lang} />
      ) : section === 'about' ? (
        <p class="portfolio-copy">{aboutText}</p>
      ) : section === 'residencies' ? (
        <section class="portfolio-residencies" aria-labelledby="portfolio-residencies-title">
          <h2 id="portfolio-residencies-title">{page.title[lang]}</h2>
          <ol>
            {portfolioResidencies.map((item) => (
              <li>
                <time>{item.period[lang]}</time>
                <p>{item.description[lang]}</p>
              </li>
            ))}
          </ol>
        </section>
      ) : section === 'home' ? (
        <nav class="portfolio-leaves" aria-label={lang === 'fr' ? 'Explorer les pages' : 'Explore the pages'}>
          {portfolioSections.map((item) => (
            <a
              class:list={['portfolio-leaf', item.position, `leaf-${item.color}`, `leaf-${item.size}`]}
              href={pageUrl(lang, item.path)}
              aria-label={item.label[lang]}
              style={`--leaf-rotation: ${item.rotation}deg`}
            >
              <span>{item.label[lang]}</span>
              <svg viewBox="0 0 100 160" aria-hidden="true">
                <path class="leaf-shape" d="M50 4C22 28 5 58 8 91c3 30 21 52 42 65 21-13 39-35 42-65C95 58 78 28 50 4Z" />
                <path class="leaf-vein" d="M50 145C49 104 49 59 50 15" />
                <path class="leaf-vein" d="M49 88 27 58M50 108l23-35" />
              </svg>
            </a>
          ))}
        </nav>
      ) : (
        <p class="portfolio-copy">{pageMessage}</p>
      )}
    </main>

    <footer class="portfolio-footer">
      <span>{page.title[lang]}</span>
    </footer>
  </div>
</Layout>

<style>
  .portfolio-page {
    --ink: #171515;
    --leaf-red: #d94734;
    --leaf-yellow: #edc440;
    --leaf-blue: #3f53e8;
    box-sizing: border-box;
    display: flex;
    min-height: 100svh;
    flex-direction: column;
    padding: clamp(1.25rem, 2.65vw, 3.3rem);
    color: var(--ink);
    background: #fff;
    font-size: clamp(1rem, 1.1vw, 1.3rem);
  }

  .portfolio-header,
  .portfolio-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .portfolio-brand {
    display: flex;
    width: min(20rem, 42vw);
    flex-direction: column;
    border-top: 1px solid currentColor;
    padding-top: 0.4rem;
    color: inherit !important;
    text-decoration: none !important;
    letter-spacing: 0.1em;
  }

  .portfolio-brand strong {
    margin-top: 0.05em;
    font-size: clamp(3.4rem, 6vw, 6.5rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .portfolio-header-links {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    line-height: 1.2;
  }

  .portfolio-socials {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
  }

  .portfolio-socials a,
  .portfolio-language,
  .portfolio-footer a {
    color: inherit !important;
    text-decoration: none !important;
  }

  .portfolio-socials a:hover,
  .portfolio-language:hover,
  .portfolio-footer a:hover {
    text-decoration: underline !important;
    text-underline-offset: 0.2em;
  }

  .portfolio-language {
    margin-top: 0.5rem;
    font-size: 0.9rem;
  }

  .portfolio-main {
    display: grid;
    flex: 1;
    grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 2.5fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 10rem);
    padding-block: clamp(2rem, 5vh, 4rem);
  }

  .portfolio-main-music {
    grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 2.5fr);
  }

  .portfolio-main-residencies {
    align-items: start;
  }

  .portfolio-menu ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portfolio-menu li {
    border-bottom: 1px solid var(--ink);
  }

  .portfolio-menu a {
    display: flex;
    align-items: baseline;
    justify-content: flex-start;
    gap: 1rem;
    padding-block: 0.48rem;
    color: inherit !important;
    text-decoration: none !important;
  }

  .portfolio-menu a:hover span,
  .portfolio-menu-current span {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .portfolio-copy {
    width: 100%;
    max-width: 52rem;
    justify-self: center;
    margin: 0;
    font-size: clamp(1.1rem, 1.6vw, 1.5rem);
    line-height: 1.55;
  }

  .portfolio-leaves {
    position: relative;
    width: 100%;
    max-width: 60rem;
    aspect-ratio: 1.55;
    justify-self: end;
  }

  .portfolio-residencies {
    width: 100%;
    max-width: 58rem;
    justify-self: end;
  }

  .portfolio-residencies h2 {
    margin: 0 0 1.2rem;
    font-size: clamp(1.7rem, 2.6vw, 2.5rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .portfolio-residencies ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid #d2cecc;
    list-style: none;
  }

  .portfolio-residencies li {
    display: grid;
    grid-template-columns: minmax(6rem, 0.28fr) minmax(0, 1fr);
    gap: 1rem;
    border-bottom: 1px solid #d2cecc;
    padding-block: 0.75rem;
  }

  .portfolio-residencies time {
    font-size: 0.9em;
    font-variant-numeric: tabular-nums;
  }

  .portfolio-residencies p {
    margin: 0;
  }

  .portfolio-leaf {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: inherit !important;
    text-decoration: none !important;
    white-space: nowrap;
  }

  .portfolio-leaf svg {
    display: block;
    width: var(--leaf-width);
    height: calc(var(--leaf-width) * 1.6);
    overflow: visible;
    color: var(--leaf-color);
    transform: rotate(var(--leaf-rotation));
    filter: drop-shadow(0.35rem 0.4rem 0.55rem color-mix(in srgb, currentColor, transparent 58%));
    transition: transform 200ms ease;
  }

  .leaf-shape { fill: currentColor; }
  .leaf-vein {
    fill: none;
    stroke: #fff;
    stroke-linecap: round;
    stroke-width: 2;
    opacity: 0.65;
  }
  .portfolio-leaf:hover svg,
  .portfolio-leaf:focus-visible svg {
    transform: rotate(var(--leaf-rotation)) scale(1.12);
  }
  .leaf-red { --leaf-color: var(--leaf-red); }
  .leaf-yellow { --leaf-color: var(--leaf-yellow); }
  .leaf-blue { --leaf-color: var(--leaf-blue); }
  .leaf-large { --leaf-width: clamp(3.5rem, 4.4vw, 5.8rem); }
  .leaf-medium { --leaf-width: clamp(2.7rem, 3.3vw, 4.2rem); }
  .leaf-small { --leaf-width: clamp(1.8rem, 2.2vw, 2.8rem); }
  .leaf-tiny { --leaf-width: clamp(1.2rem, 1.4vw, 1.8rem); }
  .leaf-music { left: 83%; top: 4%; }
  .leaf-visuals { left: 42%; top: 17%; }
  .leaf-residencies { left: 66%; top: 60%; }
  .leaf-commissioned { left: 81%; top: 52%; }
  .leaf-about { left: 13%; top: 66%; }

  .portfolio-footer {
    align-items: center;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.3rem;
  }

  @media (max-width: 760px) {
    .portfolio-main {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-block: 3rem;
    }

    .portfolio-menu ol {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.2rem;
    }

    .portfolio-leaves {
      min-height: 20rem;
      aspect-ratio: 1.3;
    }

    .leaf-music { left: 79%; top: 4%; }
    .leaf-visuals { left: 42%; top: 13%; }
    .leaf-residencies { left: 65%; top: 58%; }
    .leaf-commissioned { left: 79%; top: 54%; }
    .leaf-about { left: 11%; top: 68%; }
  }

  @media (max-width: 420px) {
    .portfolio-page { padding: 1.1rem; }
    .portfolio-main { gap: 1.5rem; }
    .portfolio-menu ol { column-gap: 0.8rem; }
    .portfolio-leaves { min-height: 17rem; }
    .portfolio-residencies li { grid-template-columns: 1fr; gap: 0.2rem; }
  }
</style>
