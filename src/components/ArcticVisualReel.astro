---
interface Props {
  lang: 'en' | 'fr';
}

const { lang } = Astro.props;
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/arctic-canvas/assets`;
const clips = [
  {
    id: '7qVnsyC5lTTH2sneV01syoOjbYM102kTWzhJylQ8jWn700',
    poster: 'live-set.jpg',
    alt: {
      en: 'Yakie performing live in front of a large projection, in a wooden hall',
      fr: 'Yakie joue en live devant une grande projection, dans une salle en bois',
    },
    title: {
      en: 'Live performance at ArtSpace Muijala, FI',
      fr: 'Performance live à ArtSpace Muijala, Finlande',
    },
    description: { en: 'Live projection, wooden hall', fr: 'Projection live, salle en bois' },
    duration: '6:20',
  },
  {
    id: 'TOG00CC3Z202d8uKbxmxYCjJgNmrCC4xmAux33eLWBG3Y',
    poster: 'caustic.jpg',
    alt: {
      en: 'White caustic light lines on black, like tree rings',
      fr: 'Lignes blanches de lumière caustique sur fond noir, comme des cernes de bois',
    },
    title: { en: 'At least we tried', fr: 'At least we tried' },
    description: { en: 'Handwriting through caustics', fr: 'Écriture à travers des caustiques' },
    duration: '3:05',
  },
  {
    id: 'hM4FYPqZWDdofcTDqeNw6PSBU8029GyaXj6CTFGUXVdY',
    poster: 'home-session.jpg',
    alt: {
      en: 'Yakie playing a wooden controller, a projection reacting behind him',
      fr: 'Yakie joue sur un contrôleur en bois, avec une projection réactive derrière lui',
    },
    title: { en: 'Tree Swarm Practice', fr: 'Tree Swarm Practice' },
    description: { en: 'Gesture and real-time arranging', fr: 'Geste et arrangement en temps réel' },
    duration: '4:48',
  },
  {
    id: 'OB3l1Zav01iTCdwBS5FXKitnzctNaWAW5IlvSCxyvFXY',
    poster: 'cyanotype.jpg',
    alt: {
      en: 'Teal, painterly surge of light on a dark grain',
      fr: 'Vague de lumière turquoise, picturale, sur un grain sombre',
    },
    title: { en: 'Roaming Light', fr: 'Roaming Light' },
    description: { en: 'Audio-reactive look study', fr: 'Étude visuelle réactive au son' },
    duration: '2:30',
  },
];
---

<section
  class="arctic-reel"
  data-arctic-reel
  aria-label={lang === 'fr' ? 'Vidéos' : 'Videos'}
>
  {clips.map((clip) => (
    <figure class="arctic-clip" data-mux={clip.id}>
      <div class="arctic-clip-frame">
        <button class="arctic-clip-open" type="button" aria-label={`${lang === 'fr' ? 'Lire' : 'Play'} : ${clip.title[lang]}`}>
          <img
            src={`${assetBase}/${clip.poster}`}
            alt={clip.alt[lang]}
            width="1280"
            height="720"
          />
          <span class="arctic-clip-caption">
            <span>
              <span class="arctic-clip-title">{clip.title[lang]}</span>
              <span class="arctic-clip-description">{clip.description[lang]}</span>
            </span>
            <span class="arctic-clip-duration">
              <svg viewBox="0 0 11 11" aria-hidden="true"><path d="M2 1l8 4.5L2 10z" fill="currentColor" /></svg>
              {clip.duration}
            </span>
          </span>
        </button>
      </div>
    </figure>
  ))}
</section>

<script>
  const reel = document.querySelector<HTMLElement>('[data-arctic-reel]');

  if (reel) {
    const clips = Array.from(reel.querySelectorAll<HTMLElement>('.arctic-clip'));
    const posterButtons = new Map(
      clips.map((clip) => [clip, clip.querySelector<HTMLButtonElement>('.arctic-clip-open')]),
    );

    const stopClips = () => {
      clips.forEach((clip) => {
        const frame = clip.querySelector<HTMLElement>('.arctic-clip-frame');
        const poster = posterButtons.get(clip);
        if (frame && poster && frame.querySelector('iframe')) frame.replaceChildren(poster);
      });
    };

    clips.forEach((clip) => {
      const frame = clip.querySelector<HTMLElement>('.arctic-clip-frame');
      const button = posterButtons.get(clip);
      const playbackId = clip.dataset.mux;
      const title = clip.querySelector<HTMLElement>('.arctic-clip-title')?.textContent ?? '';
      if (!frame || !button || !playbackId) return;

      button.addEventListener('click', () => {
        stopClips();
        const iframe = document.createElement('iframe');
        iframe.src = `https://player.mux.com/${encodeURIComponent(playbackId)}?autoplay=true&video-title=${encodeURIComponent(title)}&metadata-video-title=${encodeURIComponent(title)}`;
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = title;
        frame.replaceChildren(iframe);
      });
    });
  }
</script>

<style>
  .arctic-reel {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.6rem, 1.5vw, 1rem);
  }
  .arctic-clip { min-width: 0; margin: 0; }
  .arctic-clip-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #f1efed;
  }
  .arctic-clip-frame img,
  .arctic-clip-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .arctic-clip-open {
    position: absolute;
    inset: 0;
    width: 100%;
    padding: 0;
    border: 0;
    color: inherit;
    background: transparent;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .arctic-clip-open:hover img { filter: brightness(1.08); }
  .arctic-clip-caption {
    position: absolute;
    inset: auto 0 0;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 2rem 0.65rem 0.5rem;
    color: #fff;
    background: linear-gradient(to top, rgb(4 13 22 / 85%), transparent);
  }
  .arctic-clip-title,
  .arctic-clip-description { display: block; }
  .arctic-clip-title { font-size: clamp(0.8rem, 1.1vw, 1rem); line-height: 1.2; }
  .arctic-clip-description,
  .arctic-clip-duration { font-size: 0.72rem; }
  .arctic-clip-description { color: #e7e4e2; }
  .arctic-clip-duration { display: flex; flex: none; align-items: center; gap: 0.3rem; }
  .arctic-clip-duration svg { width: 0.65rem; height: 0.65rem; }

  @media (max-width: 760px) {
    .arctic-reel { gap: 0.5rem; }
  }
  @media (max-width: 460px) {
    .arctic-reel { grid-template-columns: 1fr; }
  }
</style>
